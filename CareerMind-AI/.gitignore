# ==============================================================================
# CareerMind AI - Master .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Node.js & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/build/
.eslintcache
.turbo/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.id_rsa
secrets.json
auth_token*.json

# Databases & Local Persistence
*.sqlite
*.sqlite3
*.db
postgres-data/
redis-data/
*.dump
*.sql.gz

# Uploaded Resumes & Candidate Data (Strict Privacy / GDPR Compliance)
data/uploads/*
!data/uploads/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Machine Learning & Deep Learning Model Weights
ml_models/**/*.bin
ml_models/**/*.pt
ml_models/**/*.pth
ml_models/**/*.onnx
ml_models/**/*.safetensors
ml_models/**/*.h5
ml_models/**/*.pkl
ml_models/**/*.joblib
ml_models/**/*.ckpt
ml_models/**/*.tar.gz
!ml_models/**/.gitkeep

# Vector Databases & Embeddings
knowledge_base/embeddings/*
!knowledge_base/embeddings/.gitkeep
chroma_db/
faiss_index/
qdrant_storage/

# Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Code Quality & Formatters
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Operating System & IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Logs & Temporary Files
*.log
logs/
temp/
tmp/
*.tmp
