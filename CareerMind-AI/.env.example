# ==============================================================================
# CareerMind AI - Master Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="CareerMind AI"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-key
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL / AsyncPG)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=careermind_user
POSTGRES_PASSWORD=careermind_secure_password
POSTGRES_DB=careermind_db
DATABASE_URL=postgresql+asyncpg://careermind_user:careermind_secure_password@localhost:5432/careermind_db

# ------------------------------------------------------------------------------
# 4. REDIS (Caching & Celery/Background Tasks)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. COMMERCIAL LLM APIS (Optional / Fallback)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_token_here

# ------------------------------------------------------------------------------
# 6. LOCAL LLM SETTINGS (Ollama / vLLM / Local Transformers)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3:8b
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_TIMEOUT=60

# ------------------------------------------------------------------------------
# 7. VECTOR DATABASE & RAG (ChromaDB / Qdrant)
# ------------------------------------------------------------------------------
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./knowledge_base/embeddings/chroma
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75

# ------------------------------------------------------------------------------
# 8. FILE STORAGE & UPLOADS
# ------------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=15
ALLOWED_EXTENSIONS=["pdf", "docx", "txt"]

# ------------------------------------------------------------------------------
# 9. FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="CareerMind AI"
