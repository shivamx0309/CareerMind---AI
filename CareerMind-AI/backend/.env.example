# ==============================================================================
# CareerMind AI - Backend Environment Configuration Template
# ==============================================================================

# Database URL
# Local Development: Unset (defaults automatically to backend/careermind.db)
# Production on Render:
DATABASE_URL=sqlite:////var/data/careermind.db

# Persistent Upload Directory for Resume PDFs
# Local Development: Unset (defaults automatically to ../data/uploads)
# Production on Render:
CAREERMIND_UPLOAD_DIR=/var/data/uploads

# Allowed Frontend Origins for CORS (comma-separated list)
# Default always includes localhost:5173, 127.0.0.1:5173, localhost:3000
FRONTEND_ORIGINS=http://localhost:5173,https://YOUR-FRONTEND.vercel.app
